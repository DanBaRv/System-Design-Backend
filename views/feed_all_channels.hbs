<!doctype html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Канал</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="app-container">
    <div class="feed-page">

      <video class="feed-video" src="{{channel.videoUrl}}" autoplay muted loop playsinline></video>
      
      <div class="feed-side-actions">
        <button class="action-img" type="button">
          <svg class="action-icon" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
          </svg>
          <span>{{likes}}</span>
        </button>

        <a href="/channels/feed/{{channel.id}}?next=true" class="action-img action-next" title="Следующий канал">
          <svg class="action-icon" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 8 16 12 12 16"></polyline>
            <line x1="8" y1="12" x2="16" y2="12"></line>
          </svg>
          <span>След.</span>
        </a>
      </div>

      <div class="feed-overlay">
        <div class="channel-stats">
          <div class="stat-badge">
            <span class="stat-icon">👥</span>
            <span>Подписчиков: <b>{{channel.subscribersCount}}</b></span>
          </div>
          <div class="stat-badge">
            <span class="stat-icon">📊</span>
            <span>Средний охват: <b>{{channel.averageReach}}</b></span>
          </div>
        </div>

        <div class="feed-description">
          <span class="desc-text">{{channel.description}}</span>
          <a href="/channels/feed/{{channel.id}}?next=false" class="more-link">ещё</a>
        </div>
      </div>

    </div>

    {{> channels_navbar}}
  </div>
</body>
</html>