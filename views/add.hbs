<!doctype html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Добавить канал</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="app-container">
    <div class="add-page">
      <h1 class="page-title">Добавить канал</h1>

      {{#if draftChannel}}
      <div class="form-group">
        <label class="form-label">Вертикальное видео-превью 9:16</label>
        <div class="file-upload-area">
          <svg width="28" height="28" fill="currentColor" viewBox="0 0 24 24"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
          <span>Нажмите чтобы загрузить видео</span>
        </div>
        <img class="video-preview" src="{{draftChannel.coverUrl}}">
      </div>

      <div class="form-group">
        <label class="form-label">Обложка канала</label>
        <div class="file-upload-area">
          <svg width="28" height="28" fill="currentColor" viewBox="0 0 24 24"><path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/></svg>
          <span>Нажмите чтобы загрузить обложку</span>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Название канала</label>
        <input type="text" class="form-input" value="{{draftChannel.name}}">
      </div>
      <div class="form-group">
        <label class="form-label">Тематика канала</label>
        <input type="text" class="form-input" value="{{draftChannel.topic}}">
      </div>
      <div class="form-group">
        <label class="form-label">Количество подписчиков</label>
        <input type="number" class="form-input" value="{{draftChannel.subscribersCount}}">
      </div>
      <div class="form-group">
        <label class="form-label">Средний охват одного поста</label>
        <input type="number" class="form-input" value="{{draftChannel.averageReach}}">
      </div>
      <div class="form-group">
        <label class="form-label">Цена рекламного размещения, ₽</label>
        <input type="number" class="form-input" value="{{draftChannel.adPrice}}">
      </div>
      <div class="form-group">
        <label class="form-label">Короткое описание</label>
        <textarea class="form-input" rows="3">{{draftChannel.description}}</textarea>
      </div>
      <button type="button" class="save-btn">Сохранить канал</button>
      {{else}}
        <p>Черновиков нет — всё опубликовано ✅</p>
      {{/if}}
    </div>

    {{> navbar}}
  </div>
</body>
</html>