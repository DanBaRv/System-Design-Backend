<!doctype html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{channel.name}}</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="app-container">
    <div class="feed-page">

      <!-- пока картинка; после MinIO заменим на <video> -->
          <video class="feed-video" src="{{channel.videoUrl}}" autoplay muted loop playsinline></video>
      
      <div class="feed-side-actions">

          <div class="action-btn">
            <svg class="action-icon" fill="currentColor" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
          </div>

          <div class="action-btn">
            <svg class="action-icon" fill="currentColor" viewBox="0 0 24 24"><path d="M21 6h-2v9H6v2c0 .55.45 1 1 1h11l4 4V7c0-.55-.45-1-1-1zm-4 6V3c0-.55-.45-1-1-1H3c-.55 0-1 .45-1 1v14l4-4h10c.55 0 1-.45 1-1z"/></svg>
            <span>{{channel.commentsCount}}</span>
          </div>

          <div class="action-btn">
            <svg class="action-icon" fill="currentColor" viewBox="0 0 24 24"><path d="M17 3H7c-1.1 0-1.99.9-1.99 2L5 21l7-3 7 3V5c0-1.1-.9-2-2-2z"/></svg>
          </div>

  
          <div class="action-btn">
            <svg class="action-icon" fill="currentColor" viewBox="0 0 24 24"><path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92s2.92-1.31 2.92-2.92-1.31-2.92-2.92-2.92z"/></svg>
            <span>{{channel.repostsCount}}</span>
          </div>

          <div class="action-btn">
            <svg class="action-icon" fill="currentColor" viewBox="0 0 24 24"><path d="M6 10c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm12 0c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm-6 0c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"/></svg>
          </div>

          <div class="action-btn">
            <svg class="action-icon" fill="currentColor" viewBox="0 0 24 24"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/></svg>
          </div>

      </div>

      <div class="feed-overlay">

        <!-- 1) шапка: аватар + @имя + подписаться -->
        <div class="channel-header">
          <img src="{{channel.coverUrl}}" alt="{{channel.name}}" class="channel-avatar">
          <span class="channel-name">@{{channel.username}}</span>
          <button class="follow-btn">Подписаться</button>
        </div>

        <!-- 2) статистика -->
        <div class="channel-stats">
          <div>👥 Подписчиков: {{channel.subscribersCount}}</div>
          <div>👁️ Средний охват: {{channel.averageReach}}</div>
          <div>💸 Цена поста: {{channel.adPrice}} ₽</div>
        </div>

        <!-- 3) описание -->
        <div class="feed-description">{{channel.description}}</div>

        <!-- 4) кнопка — ПОСЛЕДНИЙ элемент потока = всегда ниже всех -->
        <a href="/feed/{{channel.id}}?next=true" class="next-btn">Следующий канал</a>
      </div>
    </div>

    {{> navbar}}
  </div>
</body>
</html>